{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "C5TAKO Docs",
  "colors": {
    "primary": "#7B21F5",
    "light": "#A855F7",
    "dark": "#6D18D9"
  },
  "logo": {
    "light": "/images/Zipher_c5tako.png",
    "dark": "/images/Zipher_c5tako.png",
    "href": "/"
  },
  "favicon": "/images/favicon.png",
  "appearance": {
    "default": "dark"
  },
  "search": {
    "prompt": "ค้นหาในคู่มือ..."
  },
  "fonts": {
    "family": "LINE Seed Sans TH",
    "source": "/fonts/LINESeedSansTH_W_Rg.woff2",
    "format": "woff2",
    "weight": 400,
    "heading": {
      "family": "LINE Seed Sans TH",
      "source": "/fonts/LINESeedSansTH_W_Bd.woff2",
      "format": "woff2",
      "weight": 700
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#F8F7FC",
      "dark": "#0D0B10"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "dracula"
      }
    }
  },
  "interaction": {
    "drilldown": false
  },
